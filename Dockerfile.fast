# Fast build — Next.js is pre-built on the host; this stage only assembles the runtime image.
# Usage: ./scripts/docker-build-fast.sh
FROM node:20-alpine AS runner

RUN apk add --no-cache sqlite

WORKDIR /app

ENV NODE_ENV=production
ENV HOME=/data
ENV PORT=3000

# Standalone output (pre-built on host)
COPY .next/standalone ./
COPY .next/static ./.next/static
COPY public ./public

# Schema needed at runtime
COPY src/db/schema.sql ./src/db/schema.sql

VOLUME ["/data"]
EXPOSE 3000

CMD ["node", "server.js"]
